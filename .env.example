# Copy to .env and fill in real values. Never commit .env.
# Every variable here overrides the matching key in policy.toml.

# The directory commands may run in. REQUIRED — here or as jail_root in
# policy.toml. Startup refuses if unset; there is no fallback to the launch
# directory, because a jail nobody chose is not a jail.
SAFE_MCP_JAIL_ROOT=/srv/safe-mcp/sandbox

# Path to the policy file. Defaults to ./policy.toml.
SAFE_MCP_POLICY_FILE=policy.toml

# The JSONL audit trail. Keep it OUTSIDE the jail root — startup refuses
# otherwise, since a permitted command could read or forge it from inside.
SAFE_MCP_AUDIT_LOG=/var/log/safe-mcp/audit.jsonl

# "closed" = refuse to run a command whose record cannot be written, so there is
# no unlogged execution. "open" = run anyway and warn on stderr.
SAFE_MCP_AUDIT_FAIL_MODE=closed
