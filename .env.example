# Copy to .env and fill in real values. Never commit .env.
# Most variables here override the matching key in policy.toml. SAFE_MCP_POLICY_FILE
# is the exception: it names the policy file itself, as an alternative to --config,
# rather than overriding a key inside one.

# Path to the policy file. Both servers read it. REQUIRED — here or as
# --config PATH. There is no default: startup refuses if neither is given,
# because a policy file nobody chose is not a policy. --config wins if both
# are set.
SAFE_MCP_POLICY_FILE=policy.toml


# --- terminal server ---------------------------------------------------------

# The directory commands may run in. REQUIRED — here or as jail_root in
# policy.toml. Startup refuses if unset; there is no fallback to the launch
# directory, because a jail nobody chose is not a jail.
SAFE_MCP_JAIL_ROOT=/srv/safe-mcp/sandbox


# --- file organizer server ---------------------------------------------------

# The directory the organizer may touch. REQUIRED — here or as
# files.workspace_root in policy.toml. Startup refuses if unset; there is no
# fallback to a folder in $HOME, and no tool can re-point it at runtime.
SAFE_MCP_WORKSPACE_ROOT=/srv/safe-mcp/inbox

# Undo/redo state. Keep it OUTSIDE the workspace root — startup refuses
# otherwise, since the organizer would treat its own journal as a file to file.
SAFE_MCP_FILES_JOURNAL=/var/lib/safe-mcp/organizer-journal.json


# --- shared ------------------------------------------------------------------

# The JSONL audit trail, shared by both servers. Keep it OUTSIDE the jail root
# and outside the workspace root — startup refuses otherwise, since a permitted
# command could read or forge it, and the organizer could file it away.
SAFE_MCP_AUDIT_LOG=/var/log/safe-mcp/audit.jsonl

# "closed" = refuse to run a command whose record cannot be written, so there is
# no unlogged execution. "open" = run anyway and warn on stderr.
SAFE_MCP_AUDIT_FAIL_MODE=closed
